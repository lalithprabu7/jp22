# ========================================================
# ContractWatch — Git Ignore Rules
# ========================================================

# Compiled Java Classes & Artifacts
backend/target/
**/target/
*.class
*.jar
*.war

# Database files
backend/data/
**/data/
*.mv.db
*.trace.db

# Node & Frontend dependencies
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
frontend/.env.local
frontend/.env.*.local

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS Metadata
.idea/
*.iml
.vscode/
*.suo
*.user
.DS_Store
Thumbs.db
